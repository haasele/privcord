# Fully isolated: K3s runs in THIS container (no KIND, no nested node). Docker only for building images.
# Requires: docker run --privileged (and on cgroup v2: -v /sys/fs/cgroup:/sys/fs/cgroup:rw --cgroupns=host).
# Usage: docker build -f docker/Dockerfile.ubuntu-k3s -t privcord-k3s .  (from enterprise-matrix-stack)
FROM ubuntu:latest

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    python3 \
    python3-pip \
    python3-venv \
    docker.io \
    && pip install --break-system-packages --no-cache-dir pyyaml \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# K3s binary (runs server + containerd in this container, no nested node)
RUN curl -sSfL "https://github.com/k3s-io/k3s/releases/download/v1.28.9%2Bk3s1/k3s" -o /usr/local/bin/k3s \
    && chmod +x /usr/local/bin/k3s

# kubectl
RUN curl -sL "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl

WORKDIR /workspace

COPY docker/entrypoint-k3s.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV DOCKER_HOST=unix:///var/run/docker.sock
ENV K3S_KUBECONFIG=/etc/rancher/k3s/k3s.yaml

ENTRYPOINT ["/entrypoint.sh"]
