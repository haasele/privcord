# Fully isolated: Kubernetes (KIND) runs INSIDE this container. No host Docker socket.
# Requires: docker run --privileged (Docker-in-Docker).
# Usage: docker build -f docker/Dockerfile.ubuntu-kind -t privcord-kind .  (from enterprise-matrix-stack)
#        docker run -it --rm --privileged privcord-kind
FROM ubuntu:latest

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    python3 \
    python3-pip \
    python3-venv \
    docker.io \
    && pip install --break-system-packages --no-cache-dir pyyaml \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# kubectl
RUN curl -sL "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl

# KIND (Kubernetes in Docker)
RUN curl -sLo /usr/local/bin/kind "https://kind.sigs.k8s.io/dl/v0.28.0/kind-linux-amd64" \
    && chmod +x /usr/local/bin/kind

WORKDIR /workspace

COPY docker/entrypoint-kind.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# So KIND and docker build use the daemon we start
ENV DOCKER_HOST=unix:///var/run/docker.sock

ENTRYPOINT ["/entrypoint.sh"]
