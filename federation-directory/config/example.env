# Federation Directory — example env. Copy to .env and set DIRECTORY_API_KEY.
DIRECTORY_API_KEY=your-secret-key
DIRECTORY_DATA_PATH=/data/servers.json
DIRECTORY_HOST=0.0.0.0
DIRECTORY_PORT=8765
# Optional: CORS for GET /api/v1/servers (comma-separated)
# DIRECTORY_CORS_ORIGINS=https://app.example.com
